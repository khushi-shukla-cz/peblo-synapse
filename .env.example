# Local environment example — copy to .env and fill values

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client - Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI gateway
LLM_API_KEY=
LLM_GATEWAY_URL=https://api.openai.com/v1/chat/completions

# Node
NODE_ENV=development

# Optional: your local dev port
# PORT=5173
